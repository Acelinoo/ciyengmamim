datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Admin User for Dashboard Authentication
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // Hashed with argon2id / bcrypt-ts (NOT plaintext)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2. Admin Audit Log (Keamanan Aktivitas Sensitif)
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String   // e.g. "UPDATE_PAYMENT_CONFIG", "DELETE_PRODUCT", "CHANGE_PRICE"
  resource   String   // e.g. "PaymentSettings", "Product:clx123"
  details    String?  // JSON stringified summary of change
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminEmail])
  @@index([createdAt])
}

// 3. Store Profile & Contact Information (Single-row Settings)
model StoreSettings {
  id              String   @id @default("default_store")
  storeName       String   @default("Ciyeng Mamim")
  tagline         String?  @default("Balikin Mood with Good Food")
  logoUrl         String?  @default("/images/logo.png")
  whatsappNumber  String   @default("6289676636637")
  instagramHandle String?  @default("ciyengmamim")
  instagramUrl    String?  @default("https://instagram.com/ciyengmamim")
  address         String?  @default("Jl Raya gading tutuka GC Kuliner pujasera, Soreang")
  mapsUrl         String?
  mapsEmbedUrl    String?
  updatedAt       DateTime @updatedAt
}

// 4. Operational Hours & Live Store Status (Single-row Settings)
model OperationalSettings {
  id             String   @id @default("default_operational")
  isStoreOpen    Boolean  @default(true) // Manual Master Override
  autoSchedule   Boolean  @default(true) // Enable/Disable automatic hours check
  openTime       String   @default("10:00") // Format HH:mm (WIB)
  closeTime      String   @default("21:00") // Format HH:mm (WIB)
  closedDays     String[] @default(["Senin"]) // Array hari libur, misal: ["Senin"]
  closedMessage  String?  @default("Toko sedang tutup. Kami kembali melayani di jam operasional.")
  updatedAt      DateTime @updatedAt
}

// 5. Products / Menu Items
model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  price       Int             // Dalam satuan Rupiah penuh (contoh: 3500)
  imageUrl    String
  isAvailable Boolean         @default(true)
  sortOrder   Int             @default(0)
  variants    VariantOption[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// Sub-entity: Pilihan Varian Produk
model VariantOption {
  id        String   @id @default(cuid())
  name      String
  price     Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 6. Package Bundling Items
model Package {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  price          Int
  imageUrl       String
  packageItems   String[]
  includedSauces String[]
  isAvailable    Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 7. Add-ons & Extra Sauces
model AddOn {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  imageUrl    String?
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 8. Payment Configurations (Single-row Settings)
model PaymentSettings {
  id            String   @id @default("default_payment")
  bankName      String   @default("BCA")
  accountNumber String   @default("7772345678")
  accountHolder String   @default("CIYENG MAMIM")
  bankNotes     String?  @default("Mohon transfer sesuai total tagihan dan unggah bukti transfer.")
  qrisImageUrl  String?
  qrisNmid      String?
  isQrisActive  Boolean  @default(true)
  isBankActive  Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

// 9. Ephemeral Payment Proof Metadata (with persistent Base64 Data URL)
model PaymentProof {
  id          String   @id @default(cuid())
  accessToken String   @unique @default(cuid())
  filePath    String
  fileSize    Int
  mimeType    String
  fileData    String?  @db.Text // Base64 data URL untuk jaminan 100% foto tampil di Vercel
  uploadedAt  DateTime @default(now())
  expiresAt   DateTime

  @@index([accessToken])
  @@index([expiresAt])
}
